{
  "skillListingBudgetFraction": 0.04,
  "env": {
    "k1": "example",
    "k2": "example",
    "k3": "example",
    "k4": "example"
  },
  "attribution": {
    "k5": "example",
    "k6": "example"
  },
  "includeCoAuthoredBy": false,
